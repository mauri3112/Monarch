# Monarch runs locally without hosted accounts or a relay.
# Copying this file does not connect to T3 production services.
# Keep credentials and local paths in your untracked .env.

# Optional isolated data directory. Default: ~/.monarch.
# MONARCH_HOME=/absolute/path/to/monarch-data

# Analytics are disabled unless consent, endpoint, and key are all configured.
MONARCH_TELEMETRY_ENABLED=false
# MONARCH_POSTHOG_HOST=https://analytics.example.com
# MONARCH_POSTHOG_KEY=your-ingest-key

# Development starts with an empty database. --seed explicitly imports an
# existing Monarch database into an isolated worktree; it never reads ~/.t3.
MONARCH_DEV_SEED=false

# Optional reviewed model catalog override. Without this, only the bundled catalog is used.
# MONARCH_MODEL_MANIFEST_URL=https://models.example.com/manifest.json

# Advanced: independently operated hosted services. Internal T3CODE names are
# retained for compatibility; use only identifiers from your own deployment.
# T3CODE_CLERK_PUBLISHABLE_KEY=your-public-key
# T3CODE_CLERK_JWT_TEMPLATE=your-jwt-template
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=your-oauth-client-id
# T3CODE_RELAY_URL=https://relay.example.com
# T3CODE_HOSTED_APP_URL=https://app.example.com
